<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ad_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gnt_bg_dark"
    android:elevation="100dp">

    <!-- NativeAdView hiển thị toàn màn hình No Media (dùng chung cho cả Portrait và Landscape) -->
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gnt_bg_dark">

            <!-- 1. Header ở phía trên cùng, cao bằng bottom_card: chứa nhãn Ad, Headline, Advertiser -->
            <View
                android:id="@+id/top_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/gnt_fs_bottom_card_height"
                android:background="@color/gnt_bg_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Đường phân cách giữa top_card và no_media_container (màu #505763) -->
            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#505763"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top_card" />

            <!-- 2. Nền Footer ở phía dưới cùng, chỉ chứa nút CTA -->
            <View
                android:id="@+id/bottom_card"
                android:layout_width="0dp"
                android:layout_height="@dimen/gnt_fs_bottom_card_height"
                android:background="@color/gnt_bg_dark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 3. Khung chứa Icon lớn thay thế MediaView ở khu vực giữa divider và bottom_card -->
            <FrameLayout
                android:id="@+id/no_media_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@id/bottom_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <ImageView
                    android:id="@+id/icon"
                    android:layout_width="@dimen/no_media_icon_size"
                    android:layout_height="@dimen/no_media_icon_size"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    tools:src="@android:drawable/sym_def_app_icon" />
            </FrameLayout>

            <!-- 4. Nút CTA kéo dài hết chiều ngang footer, cách lề 20dp (căn giữa theo chiều dọc) -->
            <android.widget.Button
                android:id="@+id/cta"
                android:layout_width="0dp"
                android:layout_height="@dimen/gnt_fs_cta_height"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/btn_cta_blue"
                android:gravity="center"
                android:maxLines="1"
                android:text="Open"
                android:textColor="@color/gnt_white"
                android:textSize="@dimen/gnt_fs_cta_text_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/bottom_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/bottom_card" />

            <!-- 5. Nhãn Ad màu vàng: căn giữa theo chiều dọc với Headline -->
            <TextView
                android:id="@+id/ad_notification_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gnt_inter_top_badge_margin_start"
                android:background="@drawable/ad_badge_yellow_background"
                android:gravity="center"
                android:paddingBottom="1dp"
                android:paddingEnd="6dp"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:text="Ad"
                android:textColor="@color/gnt_ad_badge_text_brown"
                android:textSize="@dimen/gnt_fs_ad_badge_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/headline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/headline" />

            <!-- 6. Headline bên phải nhãn Ad, kéo dài hết chiều ngang (nằm dưới nút Skip):
                 phần tử đầu chuỗi dọc packed cùng Advertiser trong top_card -->
            <TextView
                android:id="@+id/headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingEnd="@dimen/gnt_fs_headline_padding_end"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/gnt_white"
                android:textSize="@dimen/gnt_fs_headline_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/advertiser"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ad_notification_view"
                app:layout_constraintTop_toTopOf="@id/top_card"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="Headline" />

            <!-- 7. Advertiser / Mô tả phụ: phần tử thứ hai trong chuỗi dọc packed -->
            <TextView
                android:id="@+id/advertiser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:paddingEnd="@dimen/gnt_fs_advertiser_padding_end"
                android:layout_marginStart="@dimen/gnt_inter_top_badge_margin_start"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B6BCC3"
                android:textSize="@dimen/gnt_fs_secondary_size"
                app:layout_constraintBottom_toBottomOf="@id/top_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headline"
                tools:text="body/advertise" />

            <!-- 8. Nút Skip (Close) dạng Pill bo góc phải ở góc trên bên phải (vẽ đè lên Headline) -->
            <TextView
                android:id="@+id/ad_close_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gnt_fs_skip_margin_top"
                android:background="@drawable/bg_countdown_pill_right"
                android:drawableStart="@drawable/ic_skip_next"
                android:drawablePadding="@dimen/gnt_fs_skip_drawable_padding"
                android:elevation="20dp"
                android:gravity="center_vertical"
                android:outlineProvider="none"
                android:paddingBottom="@dimen/gnt_fs_skip_padding_vertical"
                android:paddingEnd="@dimen/gnt_fs_skip_padding_horizontal"
                android:paddingStart="@dimen/gnt_fs_skip_padding_horizontal"
                android:paddingTop="@dimen/gnt_fs_skip_padding_vertical"
                android:text="Skip"
                android:textColor="@color/gnt_white"
                android:textSize="@dimen/gnt_fs_skip_text_size"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

            <!-- 9. Thanh progress đếm ngược màu vàng sát mép trên màn hình -->
            <ProgressBar
                android:id="@+id/ad_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:indeterminate="false"
                android:progress="0"
                android:progressDrawable="@drawable/line_yellow_progress_bar"
                android:tag="line_fill"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</FrameLayout>
